$wgExtensionFunctions[] = static function () {
    if ( !class_exists( 'CharmS3FileBackend', false ) ) {
        class CharmS3FileBackend extends AmazonS3FileBackend {
            protected function getLocalCopyCached( $src ) {
                $file = AmazonS3LocalCache::get( $src );
                $dstPath = $file->getPath();
                if ( $file->exists() && $file->getSize() > 0 ) {
                    $this->logger->debug(
                        'S3FileBackend: found {src} in local cache: {dstPath}',
                        [ 'src' => $src, 'dstPath' => $dstPath ]
                    );
                    return $file;
                }

                $srcPath = $this->getFileHttpUrl( [ 'src' => $src ] );
                if ( !$srcPath ) {
                    return null;
                }

                $this->logger->debug(
                    'S3FileBackend: downloading {src} to {dstPath}',
                    [ 'src' => $src, 'dstPath' => $dstPath ]
                );
                wfMkdirParents( dirname( $dstPath ) );
                $this->s3trapWarnings();
                try {
                    $profiling = new AmazonS3ProfilingAssist( "downloading $src from S3" );
                    $ok = $this->downloadObject( $srcPath, $dstPath );
                    $profiling->log();
                } finally {
                    $this->s3untrapWarnings();
                }
                AmazonS3LocalCache::postDownloadLogic( $file );
                return $ok ? $file : null;
            }

            private function downloadObject( string $url, string $path ): bool {
                if ( !extension_loaded( 'curl' ) || curl_version()['version_number'] < 0x075600 ) {
                    throw new RuntimeException( 'S3 proxy downloads require PHP cURL with libcurl >= 7.86.0.' );
                }
                $output = fopen( $path, 'wb' );
                if ( $output === false ) {
                    return false;
                }
                $success = false;
                try {
                    $handle = curl_init( $url );
                    curl_setopt_array( $handle, [
                        CURLOPT_FILE => $output,
                        CURLOPT_CONNECTTIMEOUT => 10,
                        CURLOPT_TIMEOUT => 3600,
                        CURLOPT_LOW_SPEED_LIMIT => 1024,
                        CURLOPT_LOW_SPEED_TIME => 60,
                        CURLOPT_FOLLOWLOCATION => true,
                        CURLOPT_MAXREDIRS => 5,
                    ] );
                    $completed = curl_exec( $handle );
                    $status = curl_getinfo( $handle, CURLINFO_RESPONSE_CODE );
                    $success = $completed && $status >= 200 && $status < 300;
                    if ( !$success ) {
                        wfDebugLog( 'AWS', 'S3 download failed: cURL code ' . curl_errno( $handle ) . ', HTTP status ' . $status );
                    }
                } finally {
                    fclose( $output );
                    if ( !$success ) {
                        unlink( $path );
                    }
                }
                return $success;
            }
        }
    }
    $GLOBALS['wgFileBackends']['s3']['class'] = CharmS3FileBackend::class;
};
